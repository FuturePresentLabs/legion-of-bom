# Copy to .env and fill in. .env is gitignored — never commit real keys.
#
# API keys are user-level secrets — one account, all your repos. The durable
# home for them is the user-global ~/.lob/credentials (same KEY=value format as
# this file), which `lob` loads from ANY working directory. A repo-local .env
# still works and takes precedence (real env vars > repo .env > ~/.lob/credentials),
# handy for per-repo dev overrides. Never put keys in a *circuits* repo's .env.
#
#   mkdir -m 700 -p ~/.lob && cp .env ~/.lob/credentials && chmod 600 ~/.lob/credentials

# Mouser Search API — live BOM pricing/stock (epic: BOM & sourcing)
MOUSER_API_KEY=

# JLCPCB API — distributor-official part data / datasheet URLs (epic: Parts library)
JLCPCB_ACCESS_KEY=
JLCPCB_SECRET_KEY=

# System One / Jev-compatible decision API (epic: legion-of-bom-utn). Defaults to
# the hosted ai.fpl.dev/v1 endpoint (a bifrost gateway — get a key from
# ~/.fpl/bifrost-api-key or the bifrost dashboard); override SYSTEMONE_BASE_URL
# to point at a local Jev-compatible dev server instead (e.g.
# http://<lan-ip>:<port>/v1) — any non-empty SYSTEMONE_API_KEY value works if
# that server doesn't check it. SYSTEMONE_MODEL names the model on whichever
# endpoint you're pointed at — "jev-latest" is the stock Jev API's own name,
# not universal; a multi-model gateway like bifrost uses its own routable ids
# (check its /v1/models) — ai.fpl.dev's working one today is
# convaiinnovations/laya.
SYSTEMONE_API_KEY=
SYSTEMONE_BASE_URL=
SYSTEMONE_MODEL=
