# Copy to .env and fill in. .env is gitignored — never commit real keys.
#
# API keys are user-level secrets — one account, all your repos. The durable
# home for them is the user-global ~/.lob/credentials (same KEY=value format as
# this file), which `lob` loads from ANY working directory. A repo-local .env
# still works and takes precedence (real env vars > repo .env > ~/.lob/credentials),
# handy for per-repo dev overrides. Never put keys in a *circuits* repo's .env.
#
#   mkdir -m 700 -p ~/.lob && cp .env ~/.lob/credentials && chmod 600 ~/.lob/credentials

# Mouser Search API — live BOM pricing/stock (epic: BOM & sourcing)
MOUSER_API_KEY=

# JLCPCB API — distributor-official part data / datasheet URLs (epic: Parts library)
JLCPCB_ACCESS_KEY=
JLCPCB_SECRET_KEY=

# OODA (System One / Jev/Laya-compatible decision API, epic: legion-of-bom-utn)
# — shared client, ../ooda in this ecosystem. Defaults to the hosted
# ai.fpl.dev bifrost gateway (get a key from ~/.fpl/bifrost-api-key or the
# bifrost dashboard) and its "fpl/decide" routing alias; override
# OODA_BASE_URL for a local Jev/Laya-compatible dev server instead (any
# non-empty OODA_API_KEY works if that server doesn't check it). OODA_MODEL
# overrides the routing alias with a specific downstream model id if you need
# to pin one (check the endpoint's /v1/models) — convaiinnovations/laya is a
# confirmed-working one on ai.fpl.dev.
OODA_API_KEY=
OODA_BASE_URL=
OODA_MODEL=
