# Copy to .env and fill in. .env is gitignored — never commit real keys.
#
# API keys are user-level secrets — one account, all your repos. The durable
# home for them is the user-global ~/.lob/credentials (same KEY=value format as
# this file), which `lob` loads from ANY working directory. A repo-local .env
# still works and takes precedence (real env vars > repo .env > ~/.lob/credentials),
# handy for per-repo dev overrides. Never put keys in a *circuits* repo's .env.
#
#   mkdir -m 700 -p ~/.lob && cp .env ~/.lob/credentials && chmod 600 ~/.lob/credentials

# Mouser Search API — live BOM pricing/stock (epic: BOM & sourcing)
MOUSER_API_KEY=

# JLCPCB API — distributor-official part data / datasheet URLs (epic: Parts library)
JLCPCB_ACCESS_KEY=
JLCPCB_SECRET_KEY=
